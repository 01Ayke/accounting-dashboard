<UserControl x:Class="App.Views.CreateCompteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.DataContext>
        <vm:CreateCompteViewModel/>
    </UserControl.DataContext>

    <Grid Background="#F5F7FA" Margin="20">
        <Border Background="White"
                CornerRadius="12"
                Padding="25"
                MaxWidth="700"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>

                <TextBlock Text="Créer un compte comptable"
                           FontSize="28"
                           FontWeight="Bold"
                           Margin="0,0,0,20"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Numéro de compte"/>
                <TextBox Text="{Binding NumeroCompte, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,5,0,12"
                         Height="35"/>

                <TextBlock Text="Libellé"/>
                <TextBox Text="{Binding Libelle, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,5,0,12"
                         Height="35"/>

                <TextBlock Text="Racine PCG"/>
                <TextBox Text="{Binding RacinePcg, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,5,0,20"
                         Height="35"/>

                <TextBlock Text="{Binding Message}"
                           Margin="0,0,0,15"
                           Foreground="Red"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Retour"
                            Width="120"
                            Height="40"
                            Margin="5"
                            Click="BackButton_Click"/>

                    <Button Content="Créer le compte"
                            Width="160"
                            Height="40"
                            Margin="5"
                            Background="#F57C00"
                            Foreground="White"
                            Command="{Binding CreateCompteCommand}"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>