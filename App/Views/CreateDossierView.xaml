<UserControl x:Class="App.Views.CreateDossierView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="900">

    <UserControl.DataContext>
        <vm:CreateDossierViewModel/>
    </UserControl.DataContext>

    <Grid Background="#F5F7FA">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Background="White" CornerRadius="12" Padding="30"
                    MaxWidth="720" Margin="20" HorizontalAlignment="Center">
                <StackPanel>

                    <!-- Titre -->
                    <TextBlock Text="Créer un dossier client"
                               FontSize="26" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,5"/>
                    <TextBlock Text="Renseignez les informations de l'entreprise"
                               FontSize="13" Foreground="Gray"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,25"/>

                    <!-- Indicateur de chargement des dropdowns -->
                    <Border Visibility="{Binding IsLoadingDropdowns, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="#EFF6FF" CornerRadius="8" Padding="10" Margin="0,0,0,15">
                        <TextBlock Text="⏳ Chargement des données de référence..."
                                   Foreground="#1D4ED8" FontSize="13" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Section Entreprise -->
                    <Border Background="#F8FAFC" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Informations entreprise"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="#0D1B2A" Margin="0,0,0,12"/>

                            <TextBlock Text="Dénomination sociale *" FontSize="12" Foreground="#374151"/>
                            <TextBox Text="{Binding DenominationSociale, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,12" Height="36" Padding="8,0"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Téléphone" FontSize="12" Foreground="#374151"/>
                                    <TextBox Text="{Binding Telephone, UpdateSourceTrigger=PropertyChanged}"
                                             Height="36" Padding="8,0" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding TelephoneError}" Foreground="#DC2626" FontSize="11" Margin="0,2,0,0"
                                               Visibility="{Binding TelephoneError, Converter={StaticResource StringToVisibilityConverter}}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Email professionnel" FontSize="12" Foreground="#374151"/>
                                    <TextBox Text="{Binding Mail, UpdateSourceTrigger=PropertyChanged}"
                                             Height="36" Padding="8,0" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding EmailError}" Foreground="#DC2626" FontSize="11" Margin="0,2,0,0"
                                               Visibility="{Binding EmailError, Converter={StaticResource StringToVisibilityConverter}}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Capital social (€) *" FontSize="12" Foreground="#374151"/>
                            <TextBox Text="{Binding Capital, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,0" Height="36" Padding="8,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Section Statut juridique & fiscal -->
                    <Border Background="#F8FAFC" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Statut juridique et fiscal"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="#0D1B2A" Margin="0,0,0,12"/>

                            <TextBlock Text="Forme juridique *" FontSize="12" Foreground="#374151"/>
                            <ComboBox ItemsSource="{Binding FormesJuridiques}"
                                      SelectedItem="{Binding SelectedFormeJuridique}"
                                      DisplayMemberPath="Libelle"
                                      Margin="0,4,0,12" Height="36"/>

                            <TextBlock Text="Régime fiscal *" FontSize="12" Foreground="#374151"/>
                            <ComboBox ItemsSource="{Binding RegimesFiscaux}"
                                      SelectedItem="{Binding SelectedRegimeFiscal}"
                                      DisplayMemberPath="Libelle"
                                      Height="36" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Section Adresse -->
                    <Border Background="#F8FAFC" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Adresse du siège social"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="#0D1B2A" Margin="0,0,0,12"/>

                            <TextBlock Text="Rue" FontSize="12" Foreground="#374151"/>
                            <TextBox Text="{Binding Rue, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,12" Height="36" Padding="8,0"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Code postal" FontSize="12" Foreground="#374151"/>
                                    <TextBox Text="{Binding CodePostal, UpdateSourceTrigger=PropertyChanged}"
                                             Height="36" Padding="8,0" Margin="0,4,0,0" MaxLength="5"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Ville" FontSize="12" Foreground="#374151"/>
                                    <TextBox Text="{Binding Ville, UpdateSourceTrigger=PropertyChanged}"
                                             Height="36" Padding="8,0" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Pays" FontSize="12" Foreground="#374151"/>
                            <TextBox Text="{Binding Pays, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,0" Height="36" Padding="8,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Message de retour -->
                    <Border Margin="0,0,0,15" CornerRadius="8" Padding="12"
                            Visibility="{Binding Message, Converter={StaticResource StringToVisibilityConverter}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FEF2F2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                        <Setter Property="Background" Value="#F0FDF4"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Message}" FontWeight="SemiBold" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#DC2626"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                            <Setter Property="Foreground" Value="#16A34A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- Boutons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="← Retour"
                                Width="120" Height="42" Margin="5"
                                Click="BackButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#374151"/>
                                    <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="✓ Créer le dossier"
                                Width="180" Height="42" Margin="5"
                                Command="{Binding CreateDossierCommand}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#16A34A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#15803D"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#166534"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
