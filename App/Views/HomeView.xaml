<UserControl x:Class="App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.DataContext>
        <vm:HomeViewModel/>
    </UserControl.DataContext>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <!-- Premier Border (en haut) -->
            <RowDefinition Height="Auto"/>
            <!-- Espace -->
            <RowDefinition Height="20"/>
            <!-- Deuxième Border prend 60% de l'espace restant -->
            <RowDefinition Height="6*"/>
            <!-- Espace du bas (environ 5%) -->
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Grid.Background>
            <ImageBrush ImageSource="/App;component/Images/fond_login.jpg" Stretch="UniformToFill"
                        Opacity="0.4"/>
        </Grid.Background>

        <!-- Premier Border -->
        <Border Grid.Row="0"
                Padding="30"
                CornerRadius="12"
                Background="#CCFFFFFF"
                HorizontalAlignment="Center"
                MaxWidth="800"
                Effect="{DynamicResource DropShadowEffect}">
            <StackPanel>
                <TextBlock Text="Portefeuille Contrats" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Margin="0,0,0,5"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Gérez vos dossiers clients et accédez aux informations clés"
                           FontSize="14"
                           Foreground="Gray"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

       <!-- Border principal -->
<Border Grid.Row="2"
        Padding="10"
        CornerRadius="12"
        Background="White"
        HorizontalAlignment="Center"
        VerticalAlignment="Stretch"
        Width="1100"
        Effect="{DynamicResource DropShadowEffect}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- barre de recherche -->
            <RowDefinition Height="Auto"/> <!-- bandeau gris -->
            <RowDefinition Height="*"/>    <!-- LISTE SCROLLABLE -->
        </Grid.RowDefinitions>
        

        <!-- Barre de recherche + ComboBox -->
        <Grid Margin="0,0,0,10" Height="35">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>

            <!-- TextBox + placeholder -->
            <Grid Grid.Column="0">
                <TextBox x:Name="ResearchBox"
                         Width="300" Height="35"
                         Padding="5" Background="White" BorderBrush="Gray"
                         BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsFocused" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="DodgerBlue"/>
                                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <TextBlock Text="🔍 Rechercher par nom, contact, SIRET, ..."
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           Width="300"
                           Foreground="Gray"
                           IsHitTestVisible="False"
                           Visibility="{Binding Text, ElementName=ResearchBox, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
            </Grid>

           <Grid Grid.Column="2" Width="150" Height="25">
                <!-- ComboBox -->
                <ComboBox x:Name="SortComboBox"
                          Width="150"
                          Height="25"
                          SelectedIndex="-1"
                          SelectedItem="{Binding SelectedSortOption}">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Background" Value="SteelBlue"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="LightSteelBlue"/>
                                                <Setter Property="Foreground" Value="Black"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                    <Condition Property="IsSelected" Value="False"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="Bd" Property="Background" Value="DodgerBlue"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ComboBox.ItemContainerStyle>


                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="↑↓" Margin="0,0,5,0"/>
                            <TextBlock Text="(A-Z) Nom" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="↑↓" Margin="0,0,5,0"/>
                            <TextBlock Text="(Z-A) Nom" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="↑↓" Margin="0,0,5,0"/>
                            <TextBlock Text="Date ( Plus récent )" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="↑↓" Margin="0,0,5,0"/>
                            <TextBlock Text="Date ( Plus ancien )" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="↑↓" Margin="0,0,5,0"/>
                            <TextBlock Text="Statut"/>
                        </StackPanel>
                    </ComboBoxItem>
                </ComboBox>

                <!-- Placeholder Texte -->
                <TextBlock Text="↑↓ Trier par"
                           Foreground="Black"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=SortComboBox}" Value="-1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=SortComboBox}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=SortComboBox}" Value="1">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=SortComboBox}" Value="2">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=SortComboBox}" Value="3">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=SortComboBox}" Value="4">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            
        </Grid>
        <Button Content="+ Ajouter"
                HorizontalAlignment="Right"
                Margin="0,0,10,0"
                VerticalAlignment="Center"
        >
                
        </Button>

        <Grid Grid.Row="1" Background="AliceBlue" Height="40" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Entreprise / SIRET"
                       Grid.Column="0"
                       FontWeight="SemiBold"
                       Foreground="DarkSlateGray"
                       FontSize="15"
                       VerticalAlignment="Center"
                       Margin="20,0"/>

            <TextBlock Text="Contact principal"
                       Grid.Column="1"
                       FontWeight="SemiBold"
                       Foreground="DarkSlateGray"
                       FontSize="15"
                       VerticalAlignment="Center"/>

            <TextBlock Text="Secteur"
                       Grid.Column="2"
                       FontWeight="SemiBold"
                       FontSize="15"
                       Foreground="DarkSlateGray"
                       VerticalAlignment="Center"/>

            <TextBlock Text="Statut"
                       Grid.Column="3"
                       FontWeight="SemiBold"
                       FontSize="15"
                       Foreground="DarkSlateGray"
                       VerticalAlignment="Center"/>

            <TextBlock Text=""
                       Grid.Column="4"/>
        </Grid>
           <ListBox  Grid.Row="2" ItemsSource="{Binding Dossiers}"
                     SelectedItem="{Binding DossierSelectionne}"
                    BorderThickness="0"
                    BorderBrush="LightGray" 
                    Background="Transparent" 
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    Padding="10">
               <ListBox.ItemContainerStyle>
                   <Style TargetType="ListBoxItem">
                       <Setter Property="Background" Value="White"/>
                       <Setter Property="Margin" Value="0"/> 
                       <Setter Property="Padding" Value="0"/> 
                       <Setter Property="BorderBrush" Value="LightGray"/>
                       <Setter Property="BorderThickness" Value="1"/>
                       <Setter Property="Template">
                           <Setter.Value>
                               <ControlTemplate TargetType="ListBoxItem">
                                   <Border Background="{TemplateBinding Background}"
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           BorderThickness="{TemplateBinding BorderThickness}"
                                           CornerRadius="10">
                                       <ContentPresenter/>
                                   </Border>
                                   <ControlTemplate.Triggers>
                                       <Trigger Property="IsMouseOver" Value="True">
                                           <Setter Property="Background" Value="Snow"/>
                                           <Setter Property="BorderThickness" Value="2"/>
                                           <Setter Property="BorderBrush" Value="LightGray"/>
                                       </Trigger>
                                   </ControlTemplate.Triggers>
                               </ControlTemplate>
                           </Setter.Value>
                       </Setter>
                   </Style>

               </ListBox.ItemContainerStyle>
               <ListBox.ItemTemplate>
                   <DataTemplate>
                        <Border Background="Transparent"
                                CornerRadius="10"
                                Margin="0,0,0,0">

                            <Grid Height="48">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>

                                <!-- Entreprise + SIRET -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding NomEntreprise}"
                                               FontWeight="SemiBold"
                                               FontSize="16"
                                               Margin="15,0,0,0"/>
                                    <TextBlock Text="{Binding Siret}"
                                               FontSize="11"
                                               Foreground="Gray"
                                               Margin="15,0,0,0"
                                               />
                                </StackPanel>

                                <!-- Contact -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding PrenomNomContact}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Text="{Binding EmailContact}"
                                               FontSize="11"
                                               Foreground="Gray"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Secteur -->
                                <Border Grid.Column="2"
                                        CornerRadius="12"
                                        Padding="6,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        BorderThickness="2"
                                        BorderBrush="LightGray">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="WhiteSmoke"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Secteur}"
                                               FontSize="12">

                                        
                                    </TextBlock>
                                </Border>

                                
                                <!-- Statut -->
                                <Border Grid.Column="3"
                                        CornerRadius="12"
                                        Padding="6,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        BorderThickness="2">

                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <!-- Valeurs par défaut -->
                                            <Setter Property="Background" Value="#E6F4EA"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Style.Triggers>
                                                <!-- ACTIF -->
                                                <DataTrigger Binding="{Binding Statut}" Value="Actif">
                                                    <Setter Property="Background" Value="LightGreen"/>
                                                    <Setter Property="BorderBrush" Value="Green"/>
                                                </DataTrigger>

                                                <!-- ARCHIVÉ -->
                                                <DataTrigger Binding="{Binding Statut}" Value="Archivé">
                                                    <Setter Property="Background" Value="Wheat"/>
                                                    <Setter Property="BorderBrush" Value="Tan"/>
                                                </DataTrigger>

                                                <!-- EN ATTENTE -->
                                                <DataTrigger Binding="{Binding Statut}" Value="En attente">
                                                    <Setter Property="Background" Value="#FFF4E5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <TextBlock Text="{Binding Statut}"
                                               FontSize="12"
                                               Foreground="Black">

                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#1E7F43"/>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Statut}" Value="Actif">
                                                        <Setter Property="Foreground" Value="#1E7F43"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Statut}" Value="Archivé">
                                                        <Setter Property="Foreground" Value="Gray"/>
                                                    </DataTrigger>
                                                    
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>

                                    </TextBlock>
                                </Border>

                                <!-- Menu actions -->
                                <Button Grid.Column="4"
                                        Content="⋮"
                                        FontSize="16"
                                        Width="32"
                                        Height="32"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        VerticalAlignment="Center"
                                        Click="OpenContextMenu">

                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Supprimer"
                                                      Command="{Binding DataContext.SupprimerDossierCommand,
                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>

                                </Button>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </Grid>
        </Border>

    </Grid>
</UserControl>
