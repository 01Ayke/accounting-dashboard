<UserControl x:Class="App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.DataContext>
        <vm:HomeViewModel/>
    </UserControl.DataContext>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Grid.Background>
            <ImageBrush ImageSource="/App;component/Images/fond_login.jpg" Stretch="UniformToFill" Opacity="0.4"/>
        </Grid.Background>

        <!-- Header -->
        <Border Grid.Row="0" Padding="30" CornerRadius="12" Background="#CCFFFFFF" HorizontalAlignment="Center" MaxWidth="1100" Effect="{DynamicResource DropShadowEffect}">
            <StackPanel>
                <TextBlock Text="Portefeuille Contrats" FontSize="28" FontWeight="Bold" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                <TextBlock Text="Gérez vos dossiers clients et accédez aux informations clés" FontSize="14" Foreground="Gray" HorizontalAlignment="Center"/>

                <!-- Nouveau menu d'actions -->
                <WrapPanel HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Content="+ Créer dossier"
                            Margin="5"
                            Padding="12,6"
                            Background="#4CAF50"
                            Foreground="White"
                            Click="AddButton_Click"/>

                    <Button Content="Attribuer dossier"
                            Margin="5"
                            Padding="12,6"
                            Background="#1976D2"
                            Foreground="White"
                            Click="AssignDossierButton_Click"/>

                    <Button Content="Utilisateurs / rôles"
                            Margin="5"
                            Padding="12,6"
                            Background="#7B1FA2"
                            Foreground="White"
                            Click="UserManagementButton_Click"/>

                    <Button Content="Créer compte"
                            Margin="5"
                            Padding="12,6"
                            Background="#F57C00"
                            Foreground="White"
                            Click="CreateCompteButton_Click"/>

                    <Button Content="Grand Livre"
                            Margin="5"
                            Padding="12,6"
                            Background="#455A64"
                            Foreground="White"
                            Click="GrandLivreButton_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Bloc principal -->
        <Border Grid.Row="2" Padding="10" CornerRadius="12" Background="White" HorizontalAlignment="Center" VerticalAlignment="Stretch" Width="1100" Effect="{DynamicResource DropShadowEffect}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Barre de recherche -->
                <Grid Margin="0,0,0,10" Height="35">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="ResearchBox" 
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="300" Height="35" Padding="5" Background="White" BorderBrush="Gray" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center" KeyDown="ResearchBox_KeyDown">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                                    <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="DodgerBlue"/>
                                                        <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <TextBlock Text="🔍 Rechercher..." Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Width="300" Foreground="Gray" IsHitTestVisible="False" Visibility="{Binding Text, ElementName=ResearchBox, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>

                        <Popup x:Name="SuggestionsPopup" PlacementTarget="{Binding ElementName=ResearchBox}" Placement="Bottom" IsOpen="{Binding ShowSuggestions}" AllowsTransparency="True" PopupAnimation="Slide">
                            <Border CornerRadius="0,0,8,8" Background="White" BorderBrush="LightGray" BorderThickness="1,0,1,1" Effect="{DynamicResource DropShadowEffect}">
                                <ListBox ItemsSource="{Binding SuggestionsRecherche}" MouseDown="SuggestionsListBox_MouseDown" x:Name="SuggestionsListBox" Width="300" MaxHeight="200" Background="White" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Padding="8"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>

                    <Grid Grid.Column="2" Width="150" Height="25">
                        <ComboBox x:Name="SortComboBox" Width="150" Height="25" SelectedIndex="{Binding SelectedSortIndex}">
                            <ComboBoxItem>Trier par</ComboBoxItem>
                            <ComboBoxItem>(A-Z) Nom</ComboBoxItem>
                            <ComboBoxItem>(Z-A) Nom</ComboBoxItem>
                        </ComboBox>

                        <TextBlock Text="↑↓ Trier par" Foreground="Black" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=SortComboBox}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=SortComboBox}" Value="1">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=SortComboBox}" Value="2">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Button Grid.Column="3" Content="+ Ajouter" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" Click="AddButton_Click" Cursor="Hand" Background="#4CAF50" Foreground="White" Padding="15,5"/>
                </Grid>

                <!-- En-têtes -->
                <Grid Grid.Row="1" Background="AliceBlue" Height="40" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Entreprise / SIRET" Grid.Column="0" FontWeight="SemiBold" Foreground="DarkSlateGray" FontSize="15" VerticalAlignment="Center" Margin="20,0"/>
                    <TextBlock Text="Contact principal" Grid.Column="1" FontWeight="SemiBold" Foreground="DarkSlateGray" FontSize="15" VerticalAlignment="Center"/>
                    <TextBlock Text="Secteur" Grid.Column="2" FontWeight="SemiBold" FontSize="15" Foreground="DarkSlateGray" VerticalAlignment="Center"/>
                    <TextBlock Text="Statut" Grid.Column="3" FontWeight="SemiBold" FontSize="15" Foreground="DarkSlateGray" VerticalAlignment="Center"/>
                </Grid>

                <!-- Liste -->
                <ListBox Grid.Row="2" ItemsSource="{Binding DossiersFiltrés}" SelectedItem="{Binding DossierSelectionne}" BorderThickness="0" BorderBrush="LightGray" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="10" MouseDoubleClick="Dossier_DoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="BorderBrush" Value="LightGray"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="Snow"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="AliceBlue"/>
                                                <Setter Property="BorderBrush" Value="DodgerBlue"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="Transparent" CornerRadius="10" Margin="0,0,0,0">
                                <Grid Height="48">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding NomEntreprise}" FontWeight="SemiBold" FontSize="16" Margin="15,0,0,0"/>
                                        <TextBlock Text="{Binding Siret}" FontSize="11" Foreground="Gray" Margin="15,0,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding PrenomNomContact}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding EmailContact}" FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" CornerRadius="12" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="2" BorderBrush="LightGray" Background="WhiteSmoke">
                                        <TextBlock Text="{Binding Secteur}" FontSize="12"/>
                                    </Border>

                                    <Border Grid.Column="3" CornerRadius="12" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E6F4EA"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Statut}" Value="Actif">
                                                        <Setter Property="Background" Value="LightGreen"/>
                                                        <Setter Property="BorderBrush" Value="Green"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Statut}" Value="Archivé">
                                                        <Setter Property="Background" Value="Wheat"/>
                                                        <Setter Property="BorderBrush" Value="Tan"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Statut}" FontSize="12" Foreground="Black">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#1E7F43"/>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <Button Grid.Column="4" Content="⋮" FontSize="16" Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>