<UserControl x:Class="App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.DataContext>
        <vm:HomeViewModel/>
    </UserControl.DataContext>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <!-- Premier Border (en haut) -->
            <RowDefinition Height="Auto"/>
            <!-- Espace -->
            <RowDefinition Height="20"/>
            <!-- Deuxième Border prend 60% de l'espace restant -->
            <RowDefinition Height="6*"/>
            <!-- Espace du bas (environ 5%) -->
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Grid.Background>
            <ImageBrush ImageSource="/App;component/Images/fond_login.jpg" Stretch="UniformToFill"/>
        </Grid.Background>

        <!-- Premier Border -->
        <Border Grid.Row="0"
                Padding="30"
                CornerRadius="12"
                Background="#CCFFFFFF"
                HorizontalAlignment="Center"
                MaxWidth="800"
                Effect="{DynamicResource DropShadowEffect}">
            <StackPanel>
                <TextBlock Text="Portefeuille Contrats" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Margin="0,0,0,5"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Gérez vos dossiers clients et accédez aux informations clés"
                           FontSize="14"
                           Foreground="Gray"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

       <!-- Border principal -->
<Border Grid.Row="2"
        Padding="10"
        CornerRadius="12"
        Background="White"
        HorizontalAlignment="Center"
        MaxWidth="900"
        VerticalAlignment="Stretch"
        Effect="{DynamicResource DropShadowEffect}">
    <StackPanel>

        <!-- Barre de recherche + ComboBox -->
        <Grid Margin="0,0,0,10" Height="35">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>

            <!-- TextBox + placeholder -->
            <Grid Grid.Column="0">
                <TextBox x:Name="ResearchBox"
                         Width="300" Height="35"
                         Padding="5" Background="White" BorderBrush="Gray"
                         BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsFocused" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="DodgerBlue"/>
                                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <TextBlock Text="🔍 Rechercher par nom, contact, SIRET, ..."
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           Width="300"
                           Foreground="Gray"
                           IsHitTestVisible="False"
                           Visibility="{Binding Text, ElementName=ResearchBox, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
            </Grid>

            <!-- ComboBox Trier par -->
            <ComboBox Grid.Column="2" Width="150" Height="25" VerticalAlignment="Center" Padding="5" Background="SteelBlue">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="SteelBlue"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="LightSteelBlue"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.ItemContainerStyle>
                <!-- élément par défaut -->
                <ComboBoxItem IsSelected="True">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="↑↓" Margin="0,0,5,0"/>
                        <TextBlock Text="Trier par" FontWeight="SemiBold" />
                    </StackPanel>
                </ComboBoxItem>

                <ComboBoxItem>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="↑↓" Margin="0,0,5,0"/>
                        <TextBlock Text="(A-Z) Nom" FontWeight="SemiBold"/>
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="↑↓" Margin="0,0,5,0"/>
                        <TextBlock Text="(Z-A) Nom" FontWeight="SemiBold"/>
                    </StackPanel>
                </ComboBoxItem>

                <ComboBoxItem>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="↑↓" Margin="0,0,5,0"/>
                        <TextBlock Text="Date ( Plus récent )" FontWeight="SemiBold"/>
                    </StackPanel>
                </ComboBoxItem>
                
                <ComboBoxItem>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="↑↓" Margin="0,0,5,0"/>
                        <TextBlock Text="Date ( Plus ancien )" FontWeight="SemiBold"/>
                    </StackPanel>
                </ComboBoxItem>

                <ComboBoxItem>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="↑↓" Margin="0,0,5,0"/>
                        <TextBlock Text="Statut"/>
                    </StackPanel>
                </ComboBoxItem>
            </ComboBox>

        </Grid>


                <!-- Bandeau gris avec titres -->
                <Grid Background="AliceBlue" Height="40" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Entreprise/SIRET" Foreground="DarkGray" VerticalAlignment="Center"
                               HorizontalAlignment="Center" Grid.Column="0" Margin="20,0,20,0"
                               FontWeight="Bold"/>
                    <TextBlock Text="Contact Principal" Foreground="DarkGray" VerticalAlignment="Center"
                               HorizontalAlignment="Center" Grid.Column="1" Margin="20,0,20,0"
                               FontWeight="Bold"/>
                    <TextBlock Text="Secteur" Foreground="DarkGray" VerticalAlignment="Center" 
                               HorizontalAlignment="Center" Grid.Column="2" Margin="20,0,20,0"
                               FontWeight="Bold"/>
                    <TextBlock Text="Statut" Foreground="DarkGray" VerticalAlignment="Center" HorizontalAlignment="Center"
                               Grid.Column="3" Margin="20,0,20,0"
                               FontWeight="Bold"/>
                    <TextBlock Text="Action" Foreground="DarkGray" VerticalAlignment="Center" HorizontalAlignment="Center" 
                               Grid.Column="4" Margin="20,0,20,0"
                               FontWeight="Bold"/>
                </Grid>

                <!-- Liste des contrats -->
                <ItemsControl ItemsSource="{Binding Contracts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="40" Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding ContractNumber}" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="0"/>
                                <TextBlock Text="{Binding Client}" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="1"/>
                                <TextBlock Text="{Binding Date}" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="2"/>
                                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="3"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </Border>

    </Grid>
</UserControl>
