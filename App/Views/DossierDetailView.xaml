<UserControl x:Class="App.Views.DossierDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:App.ViewModels">

    <UserControl.DataContext>
        <vm:DossierDetailViewModel/>
    </UserControl.DataContext>

    <Grid Background="White" Visibility="{Binding Dossier, Converter={StaticResource ObjectToVisibilityConverter}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- En-tête avec infos client -->
        <Border Grid.Row="0" Background="AliceBlue" Padding="20" BorderThickness="0,0,0,1" BorderBrush="LightGray">
            <StackPanel>
                <TextBlock Text="{Binding Dossier.DenominationSociale}" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="{Binding Dossier.Siret}" FontSize="12" Foreground="Gray" Margin="0,5,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Contact: " FontWeight="Bold"/>
                    <TextBlock Text="{Binding Dossier.PrenomNomContact}" Margin="5,0,0,0"/>
                    <TextBlock Text="{Binding Dossier.EmailContact}" Foreground="Blue" Margin="20,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Tableau SIG -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Padding="20">
                <StackPanel>
                    <TextBlock Text="Soldes et Indicateurs de Gestion (SIG)" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                    <!-- Grille avec les SIG -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- En-têtes -->
                        <Border Grid.Row="0" Background="LightGray" Padding="10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="Indicateur" FontWeight="Bold" Grid.Column="0"/>
                                <TextBlock Text="Montant (€)" FontWeight="Bold" Grid.Column="1" TextAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- Liste des SIG -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding SIG}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,0,0,1" BorderBrush="LightGray" Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="150"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <TextBlock Text="{Binding Nom}" Grid.Column="0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Valeur, StringFormat=N2}" Grid.Column="1" TextAlignment="Right" VerticalAlignment="Center" FontWeight="Bold"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
