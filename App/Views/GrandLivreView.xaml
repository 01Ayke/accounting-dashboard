<UserControl x:Class="App.Views.GrandLivreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1000">

    <UserControl.DataContext>
        <vm:GrandLivreViewModel/>
    </UserControl.DataContext>

    <Grid Background="#F5F7FA" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="White"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Grand Livre"
                           FontSize="28"
                           FontWeight="Bold"
                           Margin="0,0,0,20"
                           HorizontalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <StackPanel Margin="10,0">
                        <TextBlock Text="Numéro de compte"/>
                        <TextBox Text="{Binding NumeroCompte, UpdateSourceTrigger=PropertyChanged}"
                                 Width="180"
                                 Height="35"
                                 Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="10,0">
                        <TextBlock Text="Date début"/>
                        <TextBox Text="{Binding DateDebut, UpdateSourceTrigger=PropertyChanged}"
                                 Width="140"
                                 Height="35"
                                 Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="10,0">
                        <TextBlock Text="Date fin"/>
                        <TextBox Text="{Binding DateFin, UpdateSourceTrigger=PropertyChanged}"
                                 Width="140"
                                 Height="35"
                                 Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="10,20,0,0" Orientation="Horizontal">
                        <Button Content="Charger"
                                Width="120"
                                Height="35"
                                Margin="5,0"
                                Background="#455A64"
                                Foreground="White"
                                Command="{Binding LoadGrandLivreCommand}"/>

                        <Button Content="Retour"
                                Width="120"
                                Height="35"
                                Margin="5,0"
                                Click="BackButton_Click"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{Binding Message}"
                           Margin="0,15,0,0"
                           Foreground="Red"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="15">
            <DataGrid ItemsSource="{Binding Lignes}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      RowHeight="35">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="140"/>
                    <DataGridTextColumn Header="Libellé" Binding="{Binding Libelle}" Width="*"/>
                    <DataGridTextColumn Header="Débit" Binding="{Binding Debit}" Width="120"/>
                    <DataGridTextColumn Header="Crédit" Binding="{Binding Credit}" Width="120"/>
                    <DataGridTextColumn Header="Solde progressif" Binding="{Binding SoldeProgressif}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>