<UserControl x:Class="App.Views.NouveauJournalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.DataContext>
        <vm:NouveauJournalViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="FormInput" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SubmitButton" TargetType="Button">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="24,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#15803D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#166534"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F7FA">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Background="White" CornerRadius="12" Padding="36"
                    MaxWidth="600" Margin="20,40,20,20" HorizontalAlignment="Center"
                    VerticalAlignment="Top">

                <StackPanel>
                    <!-- Titre -->
                    <TextBlock Text="Nouveau journal"
                               FontSize="26" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Renseignez les informations du journal comptable"
                               FontSize="13" Foreground="Gray"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,28"/>

                    <!-- Section formulaire -->
                    <Border Background="#F8FAFC" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                        <StackPanel>

                            <!-- Nom du journal -->
                            <TextBlock Text="Nom du journal *" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Nom, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormInput}"
                                     Margin="0,0,0,16"/>

                            <!-- Code -->
                            <TextBlock Text="Code *" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormInput}"
                                     MaxLength="5"
                                     Margin="0,0,0,16"/>

                            <!-- Commentaire -->
                            <TextBlock Text="Commentaire *" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Commentaire, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="120"
                                     Padding="10,8"
                                     FontSize="13"
                                     BorderBrush="#D1D5DB"
                                     BorderThickness="1"
                                     Background="White"
                                     VerticalScrollBarVisibility="Auto"/>

                        </StackPanel>
                    </Border>

                    <!-- Message d'erreur -->
                    <Border Background="#FEF2F2" CornerRadius="8" Padding="12"
                            Margin="0,0,0,12"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#DC2626" FontSize="13"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Message de succès -->
                    <Border Background="#F0FDF4" CornerRadius="8" Padding="12"
                            Margin="0,0,0,12"
                            Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Text="{Binding SuccessMessage}"
                                   Foreground="#16A34A" FontSize="13"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Boutons -->
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="← Retour"
                                Height="40" Padding="16,0"
                                Click="BackButton_Click" Cursor="Hand"
                                Background="White" Foreground="#374151"
                                BorderBrush="#D1D5DB" BorderThickness="1">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="2" Content="✔  Créer le journal"
                                Style="{StaticResource SubmitButton}"
                                Command="{Binding ValiderCommand}"/>
                    </Grid>

                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
