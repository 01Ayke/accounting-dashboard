<UserControl x:Class="App.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.DataContext>
        <vm:UserManagementViewModel/>
    </UserControl.DataContext>

    <Grid Background="#F5F7FA" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Titre page -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Gestion des utilisateurs"
                       FontSize="26" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Créez des comptes et attribuez des rôles (rôle ADMIN requis)"
                       FontSize="13" Foreground="Gray" HorizontalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Panneau Création utilisateur ── -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="25"
                    Effect="{DynamicResource DropShadowEffect}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Créer un compte" FontSize="20" FontWeight="Bold"
                                   Margin="0,0,0,20" Foreground="#0D1B2A"/>

                        <TextBlock Text="Prénom *" FontSize="12" Foreground="#374151"/>
                        <TextBox Text="{Binding Prenom, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,12" Height="36" Padding="8,0"/>

                        <TextBlock Text="Nom *" FontSize="12" Foreground="#374151"/>
                        <TextBox Text="{Binding Nom, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,12" Height="36" Padding="8,0"/>

                        <TextBlock Text="Email *" FontSize="12" Foreground="#374151"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,12" Height="36" Padding="8,0"/>

                        <TextBlock Text="Mot de passe *" FontSize="12" Foreground="#374151"/>
                        <PasswordBox x:Name="PwdBox" Height="36" Padding="8,0" Margin="0,4,0,12"
                                     PasswordChanged="PwdBox_PasswordChanged"/>

                        <TextBlock Text="Confirmer le mot de passe *" FontSize="12" Foreground="#374151"/>
                        <PasswordBox x:Name="ConfirmPwdBox" Height="36" Padding="8,0" Margin="0,4,0,20"
                                     PasswordChanged="ConfirmPwdBox_PasswordChanged"/>

                        <!-- Sélection des rôles initiaux -->
                        <TextBlock Text="Rôles initiaux" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#374151" Margin="0,0,0,8"/>
                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,20">
                            <ItemsControl ItemsSource="{Binding NewUserRoles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}"
                                                  IsChecked="{Binding IsChecked}"
                                                  Margin="0,4" FontSize="12"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <Button Content="✓ Créer le compte" Height="42"
                                Command="{Binding CreateUserCommand}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#16A34A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#15803D"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Message création -->
                        <Border Margin="0,12,0,0" CornerRadius="8" Padding="10"
                                Visibility="{Binding CreateUserMessage, Converter={StaticResource StringToVisibilityConverter}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FEF2F2"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CreateUserSuccess}" Value="True">
                                            <Setter Property="Background" Value="#F0FDF4"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding CreateUserMessage}" FontWeight="SemiBold" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#DC2626"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CreateUserSuccess}" Value="True">
                                                <Setter Property="Foreground" Value="#16A34A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <Button Content="← Retour" Width="120" Height="38" Margin="0,15,0,0"
                                HorizontalAlignment="Left" Click="BackButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#374151"/>
                                    <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ── Panneau Attribution de rôle ── -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="25"
                    Effect="{DynamicResource DropShadowEffect}">
                <StackPanel>
                    <TextBlock Text="Attribuer des rôles" FontSize="20" FontWeight="Bold"
                               Margin="0,0,0,20" Foreground="#0D1B2A"/>

                    <TextBlock Text="Utilisateur *" FontSize="12" Foreground="#374151"/>
                    <ComboBox ItemsSource="{Binding Users}"
                              SelectedItem="{Binding SelectedUser}"
                              DisplayMemberPath="Mail"
                              Margin="0,4,0,16" Height="36"/>

                    <!-- Indicateur nombre de rôles -->
                    <Border Background="#EFF6FF" CornerRadius="8" Padding="10,8" Margin="0,0,0,12"
                            Visibility="{Binding SelectedUser, Converter={StaticResource ObjectToVisibilityConverter}}">
                        <TextBlock FontSize="13" Foreground="#1E40AF" FontWeight="SemiBold">
                            <Run Text="Rôles actifs : "/>
                            <Run Text="{Binding ActiveRoleCount, Mode=OneWay}"/>
                            <Run Text=" / 8"/>
                        </TextBlock>
                    </Border>

                    <!-- Chargement -->
                    <TextBlock Text="Chargement des rôles..."
                               FontSize="12" Foreground="Gray" Margin="0,0,0,8"
                               Visibility="{Binding RolesLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!-- Checkboxes des rôles -->
                    <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,16"
                            Visibility="{Binding SelectedUser, Converter={StaticResource ObjectToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Sélectionner les rôles" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#374151" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding UserRoles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}"
                                                  IsChecked="{Binding IsChecked}"
                                                  Margin="0,5" FontSize="12"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Button Content="✓ Appliquer les rôles" Height="42"
                            Command="{Binding AssignRoleCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#7C3AED"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#6D28D9"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Message attribution -->
                    <Border Margin="0,12,0,0" CornerRadius="8" Padding="10"
                            Visibility="{Binding AssignRoleMessage, Converter={StaticResource StringToVisibilityConverter}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FEF2F2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AssignRoleSuccess}" Value="True">
                                        <Setter Property="Background" Value="#F0FDF4"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding AssignRoleMessage}" FontWeight="SemiBold" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#DC2626"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AssignRoleSuccess}" Value="True">
                                            <Setter Property="Foreground" Value="#16A34A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- Avertissement remplacement de rôles -->
                    <Border Background="#FFFBEB" CornerRadius="8" Padding="12" Margin="0,12,0,0"
                            Visibility="{Binding SelectedUser, Converter={StaticResource ObjectToVisibilityConverter}}">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#92400E">
                            Les rôles cochés <Bold>remplaceront</Bold> tous les rôles actuels de l'utilisateur.
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
