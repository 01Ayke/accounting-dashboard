<UserControl x:Class="App.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1000">

    <UserControl.DataContext>
        <vm:UserManagementViewModel/>
    </UserControl.DataContext>

    <Grid Background="#F5F7FA" Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Création utilisateur -->
        <Border Grid.Column="0"
                Background="White"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,10,0">
            <StackPanel>
                <TextBlock Text="Créer un utilisateur"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Email"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,5,0,12"
                         Height="35"/>

                <TextBlock Text="Mot de passe"/>
                <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,5,0,12"
                         Height="35"/>

                <TextBlock Text="Confirmation mot de passe"/>
                <TextBox Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,5,0,20"
                         Height="35"/>

                <Button Content="Créer l'utilisateur"
                        Height="40"
                        Background="#4CAF50"
                        Foreground="White"
                        Command="{Binding CreateUserCommand}"/>

                <TextBlock Text="{Binding Message}"
                           Margin="0,15,0,0"
                           Foreground="Red"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>

                <Button Content="Retour"
                        Width="120"
                        Height="40"
                        Margin="0,20,0,0"
                        Click="BackButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Attribution rôle -->
        <Border Grid.Column="1"
                Background="White"
                CornerRadius="12"
                Padding="20"
                Margin="10,0,0,0">
            <StackPanel>
                <TextBlock Text="Attribuer un rôle"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <TextBlock Text="ID utilisateur"/>
                <TextBox Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,5,0,12"
                         Height="35"/>

                <TextBlock Text="Rôle"/>
                <ComboBox SelectedItem="{Binding SelectedRole}"
                          Margin="0,5,0,20"
                          Height="35">
                    <ComboBoxItem Content="Admin"/>
                    <ComboBoxItem Content="Expert"/>
                </ComboBox>

                <Button Content="Attribuer le rôle"
                        Height="40"
                        Background="#1976D2"
                        Foreground="White"
                        Command="{Binding AssignRoleCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>