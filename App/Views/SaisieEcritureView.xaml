<UserControl x:Class="App.Views.SaisieEcritureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:App.ViewModels"
             Background="#F5F7FA">

    <UserControl.DataContext>
        <vm:SaisieEcritureViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="FormInput" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SubmitButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#15803D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & global form -->
            <RowDefinition Height="*"/>    <!-- DataGrid -->
            <RowDefinition Height="Auto"/> <!-- Line Form -->
            <RowDefinition Height="Auto"/> <!-- Submit -->
        </Grid.RowDefinitions>

        <!-- Titre et infos générales (Facture, etc.) -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Saisie d'écritures comptables" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Date comptable *" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding DateSaisie, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Libellé de l'écriture *" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding LibelleEcriture, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInput}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Tableau des lignes -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="Lignes en cours de saisie" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                
                <DataGrid Grid.Row="1" ItemsSource="{Binding Lignes}" AutoGenerateColumns="False" 
                          CanUserAddRows="False" IsReadOnly="True" Background="White"
                          RowHeight="32" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E7EB">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Compte" Binding="{Binding Compte}" Width="2*"/>
                        <DataGridTextColumn Header="Débit" Binding="{Binding Debit, StringFormat={}{0:N2}}" Width="*"/>
                        <DataGridTextColumn Header="Crédit" Binding="{Binding Credit, StringFormat={}{0:N2}}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                
                <!-- Totaux équilibre -->
                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="1" Text="{Binding TotalDebit, StringFormat='Total Débits: {0:N2}'}" FontSize="14" FontWeight="Bold" Foreground="#374151"/>
                    <TextBlock Grid.Column="3" Text="{Binding TotalCredit, StringFormat='Total Crédits: {0:N2}'}" FontSize="14" FontWeight="Bold" Foreground="#374151"/>
                    <TextBlock Grid.Column="5" Text="{Binding Equilibre, StringFormat='Différence: {0:N2}'}" FontSize="14" FontWeight="Bold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#10B981" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Equilibre}" Value="0">
                                        <Setter Property="Foreground" Value="#10B981" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <!-- Formulaire Ligne -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Ajouter une ligne" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="N° Compte *" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding ComptesDisponibles}"
                                  SelectedItem="{Binding SelectedCompte, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="DisplayText"
                                  Height="32" Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                                  VerticalContentAlignment="Center" FontSize="13" Padding="8,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Débit" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding NouveauDebit, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Style="{StaticResource FormInput}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Crédit" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding NouveauCredit, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Style="{StaticResource FormInput}"/>
                    </StackPanel>

                    <Button Grid.Column="6" Content="+  Valider la ligne" Style="{StaticResource ActionButton}" 
                            Command="{Binding AjouterLigneCommand}" VerticalAlignment="Bottom"/>
                </Grid>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" Margin="0,12,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                <TextBlock Text="{Binding SuccessMessage}" Foreground="#16A34A" Margin="0,12,0,0"
                           Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
            </StackPanel>
        </Border>

        <!-- Submit global -->
        <Button Grid.Row="3" Content="✔  Valider l'ensemble des lignes" 
                Style="{StaticResource SubmitButton}" Command="{Binding ValiderEcritureCommand}"
                HorizontalAlignment="Right"/>
    </Grid>
</UserControl>
