<UserControl x:Class="App.Views.AssignDossierView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.DataContext>
        <vm:AssignDossierViewModel/>
    </UserControl.DataContext>

    <Grid Background="#F5F7FA" Margin="20">
        <Border Background="White"
                CornerRadius="12"
                Padding="25"
                MaxWidth="750"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>

                <TextBlock Text="Attribuer un dossier"
                           FontSize="28"
                           FontWeight="Bold"
                           Margin="0,0,0,20"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Sélection du dossier"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <TextBlock Text="ID du dossier"/>
                <TextBox Text="{Binding DossierId, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,5,0,20"
                         Height="35"/>

                <TextBlock Text="Sélection de l'utilisateur"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <TextBlock Text="ID utilisateur"/>
                <TextBox Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,5,0,20"
                         Height="35"/>

                <TextBlock Text="{Binding Message}"
                           Margin="0,0,0,15"
                           Foreground="Red"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Retour"
                            Width="120"
                            Height="40"
                            Margin="5"
                            Click="BackButton_Click"/>

                    <Button Content="Attribuer"
                            Width="140"
                            Height="40"
                            Margin="5"
                            Background="#1976D2"
                            Foreground="White"
                            Command="{Binding AssignCommand}"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>